# Copy this file to ".env" and fill in the values.
# Never share the .env file or upload it anywhere.

# --- Claude (the assistant's brain) ---
# Create one at https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- Server ---
PORT=3000
# Public address of the server once it's online (e.g. https://leads.yourdomain.com)
PUBLIC_BASE_URL=http://localhost:3000
# Long random text used to protect dashboard logins
SESSION_SECRET=

# --- Dashboard passwords (one per clinic: CLINIC_<ID>_PASSWORD) ---
CLINIC_BRISA_PASSWORD=change-me

# --- SMS ---
# true  = test mode: nothing is sent, use http://localhost:3000/simulator
# false = real texts through Twilio (needs the two values below)
MOCK_SMS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
