# Copy this file to ".env" and fill in the values.
# Never share the .env file or upload it anywhere.

# --- Claude (the assistant's brain) ---
# Create one at https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Mobile number the front-desk alerts are texted to, +1 and 10 digits.
# Leave empty to turn alerts off.
FRONT_DESK_PHONE=

# --- Server ---
PORT=3000
# Public address of the server once it's online (e.g. https://frontdesk.yourdomain.com)
PUBLIC_BASE_URL=http://localhost:3000
# Long random text used to protect dashboard logins
SESSION_SECRET=

# --- Dashboard passwords: one per business, BUSINESS_<ID>_PASSWORD ---
# The ID is the "id" from the file in businesses/, in capitals, dashes as underscores.
# businesses/rapido-air.json  ->  BUSINESS_RAPIDO_AIR_PASSWORD
BUSINESS_BRISA_PASSWORD=change-me
BUSINESS_RAPIDO_AIR_PASSWORD=change-me
BUSINESS_COSTA_LEGAL_PASSWORD=change-me

# --- SMS ---
# true  = test mode: nothing is sent, use http://localhost:3000/simulator
# false = real texts through Twilio (needs the two values below)
MOCK_SMS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
